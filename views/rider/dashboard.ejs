<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Food Delivery</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js" defer></script>
</head>
<body>
    <% if (success) { %>
    <div data-success="<%= success %>" style="display: none;"></div>
    <% } %>
    <% if (error) { %>
    <div data-error="<%= error %>" style="display: none;"></div>
    <% } %>

    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <h1>🍔 FoodDelivery</h1>
            </div>
            <div class="nav-links">
                <span class="user-info">Welcome, <%= rider.full_name %>!</span>
                <a href="/rider/orders" class="btn btn-primary">My Orders</a>
                <a href="/rider/orders/available" class="btn btn-outline">Available Orders</a>
                <a href="/auth/logout" class="btn btn-outline">Logout</a>
            </div>
        </div>
    </nav>

    <main class="dashboard">
        <div class="container">
            <div class="dashboard-header">
                <h1 class="dashboard-title">Rider Dashboard</h1>
                <p class="dashboard-subtitle">Manage your deliveries</p>
            </div>

            <div class="card" style="margin-bottom: 2rem;">
                <div class="card-body">
                    <div class="d-flex justify-between align-center">
                        <div>
                            <p style="margin-bottom: 0.5rem;"><strong>Status:</strong> 
                                <span class="badge <%= rider.is_available ? 'badge-delivered' : 'badge-cancelled' %>">
                                    <%= rider.is_available ? 'Available' : 'Unavailable' %>
                                </span>
                            </p>
                            <p style="margin-bottom: 0.5rem;"><strong>Vehicle:</strong> <%= rider.vehicle_type || 'N/A' %></p>
                            <p><strong>License:</strong> <%= rider.license_number || 'N/A' %></p>
                        </div>
                        <button id="toggle-availability" class="btn <%= rider.is_available ? 'btn-danger' : 'btn-success' %>">
                            <%= rider.is_available ? 'Set Unavailable' : 'Set Available' %>
                        </button>
                    </div>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-value"><%= activeOrders %></div>
                    <div class="stat-label">Active Deliveries</div>
                </div>
                <div class="stat-card secondary">
                    <div class="stat-value"><%= completedOrders %></div>
                    <div class="stat-label">Completed</div>
                </div>
                <div class="stat-card success">
                    <div class="stat-value"><%= readyOrdersCount %></div>
                    <div class="stat-label">Available Orders</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex justify-between align-center">
                    <h2 class="card-title">Quick Actions</h2>
                </div>
                <div class="card-body">
                    <div class="grid grid-3">
                        <a href="/rider/orders/available" class="card" style="text-decoration: none; color: inherit;">
                            <h3 style="color: var(--primary-color); margin-bottom: 0.5rem;">📦 Available Orders</h3>
                            <p style="color: var(--medium-gray); margin: 0;">View orders ready for pickup</p>
                        </a>
                        <a href="/rider/orders?status=picked_up" class="card" style="text-decoration: none; color: inherit;">
                            <h3 style="color: var(--primary-color); margin-bottom: 0.5rem;">🚚 Active Deliveries</h3>
                            <p style="color: var(--medium-gray); margin: 0;">View your active deliveries</p>
                        </a>
                        <a href="/rider/orders?status=delivered" class="card" style="text-decoration: none; color: inherit;">
                            <h3 style="color: var(--primary-color); margin-bottom: 0.5rem;">✅ Completed</h3>
                            <p style="color: var(--medium-gray); margin: 0;">View completed deliveries</p>
                        </a>
                    </div>
                </div>
            </div>

            <% if (recentOrders && recentOrders.length > 0) { %>
            <div class="card">
                <div class="card-header d-flex justify-between align-center">
                    <h2 class="card-title">Recent Orders</h2>
                    <a href="/rider/orders" class="btn btn-outline btn-small">View All</a>
                </div>
                <div class="card-body">
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Restaurant</th>
                                    <th>Customer</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentOrders.forEach(order => { %>
                                <tr>
                                    <td>#<%= order.order_id %></td>
                                    <td><%= order.restaurant_name %></td>
                                    <td><%= order.customer_name %></td>
                                    <td>
                                        <span class="badge badge-<%= order.order_status %>">
                                            <%= order.order_status %>
                                        </span>
                                    </td>
                                    <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <a href="/rider/orders/<%= order.order_id %>" class="btn btn-outline btn-small">View</a>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <% } else { %>
            <div class="card">
                <div class="card-body text-center">
                    <p style="color: var(--medium-gray); font-size: 1.1rem; margin-bottom: 1rem;">
                        No orders assigned yet. Check available orders to pick up deliveries.
                    </p>
                    <a href="/rider/orders/available" class="btn btn-primary">View Available Orders</a>
                </div>
            </div>
            <% } %>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Food Delivery System. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // Toggle availability
        const toggleBtn = document.getElementById('toggle-availability');
        if (toggleBtn) {
            toggleBtn.addEventListener('click', async function() {
            try {
                const response = await fetch('/rider/availability/toggle', {
                    method: 'POST'
                });
                const result = await response.json();
                
                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    alert(result.error || 'Failed to update availability');
                }
            } catch (error) {
                alert('An error occurred. Please try again.');
            }
        });
        }
    </script>
</body>
</html>
