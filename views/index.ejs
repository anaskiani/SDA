<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Delivery System - Order Delicious Food Online</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js" defer></script>
</head>
<body>
    <% if (success) { %>
    <div data-success="<%= success %>" style="display: none;"></div>
    <% } %>
    <% if (error) { %>
    <div data-error="<%= error %>" style="display: none;"></div>
    <% } %>
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <h1>🍔 FoodDelivery</h1>
            </div>
            <div class="nav-links">
                <% if (isAuthenticated) { %>
                    <span class="user-info">Welcome, <%= user.full_name %>!</span>
                    <a href="/<%= user.role %>/dashboard" class="btn btn-outline">Dashboard</a>
                    <a href="/auth/logout" class="btn btn-outline">Logout</a>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-outline">Login</a>
                    <a href="/auth/register" class="btn btn-primary">Sign Up</a>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="hero-section">
        <div class="container">
            <div class="hero-content">
                <h1 class="hero-title">Delicious Food Delivered to Your Door</h1>
                <p class="hero-subtitle">Order from your favorite restaurants and get it delivered fresh and hot</p>
                <% if (!isAuthenticated) { %>
                    <div class="hero-actions">
                        <a href="/auth/register" class="btn btn-primary btn-large">Get Started</a>
                        <a href="/auth/login" class="btn btn-secondary btn-large">Order Now</a>
                    </div>
                <% } else { %>
                    <div class="hero-actions">
                        <a href="/customer/restaurants" class="btn btn-primary btn-large">Browse Restaurants</a>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Food Delivery System. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
