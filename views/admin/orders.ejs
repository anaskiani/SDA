<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Food Delivery</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js" defer></script>
</head>
<body>
    <% if (success) { %>
    <div data-success="<%= success %>" style="display: none;"></div>
    <% } %>
    <% if (error) { %>
    <div data-error="<%= error %>" style="display: none;"></div>
    <% } %>

    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <h1>🍔 FoodDelivery</h1>
            </div>
            <div class="nav-links">
                <span class="user-info">Welcome, <%= user.full_name %>!</span>
                <a href="/admin/dashboard" class="btn btn-outline">Dashboard</a>
                <a href="/auth/logout" class="btn btn-outline">Logout</a>
            </div>
        </div>
    </nav>

    <main class="dashboard">
        <div class="container">
            <div class="dashboard-header">
                <h1 class="dashboard-title">Order Management</h1>
                <p class="dashboard-subtitle">View and monitor all orders</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex gap-2" style="flex-wrap: wrap; margin-bottom: 1rem;">
                        <a href="/admin/orders?status=all" class="btn <%= statusFilter === 'all' ? 'btn-primary' : 'btn-outline' %>">All</a>
                        <a href="/admin/orders?status=pending" class="btn <%= statusFilter === 'pending' ? 'btn-primary' : 'btn-outline' %>">Pending</a>
                        <a href="/admin/orders?status=accepted" class="btn <%= statusFilter === 'accepted' ? 'btn-primary' : 'btn-outline' %>">Accepted</a>
                        <a href="/admin/orders?status=preparing" class="btn <%= statusFilter === 'preparing' ? 'btn-primary' : 'btn-outline' %>">Preparing</a>
                        <a href="/admin/orders?status=ready" class="btn <%= statusFilter === 'ready' ? 'btn-primary' : 'btn-outline' %>">Ready</a>
                        <a href="/admin/orders?status=picked_up" class="btn <%= statusFilter === 'picked_up' ? 'btn-primary' : 'btn-outline' %>">Picked Up</a>
                        <a href="/admin/orders?status=delivered" class="btn <%= statusFilter === 'delivered' ? 'btn-primary' : 'btn-outline' %>">Delivered</a>
                        <a href="/admin/orders?status=cancelled" class="btn <%= statusFilter === 'cancelled' ? 'btn-primary' : 'btn-outline' %>">Cancelled</a>
                    </div>
                </div>
            </div>

            <% if (orders && orders.length > 0) { %>
            <div class="card">
                <div class="card-body">
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Restaurant</th>
                                    <th>Rider</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% orders.forEach(order => { %>
                                <tr>
                                    <td>#<%= order.order_id %></td>
                                    <td><%= order.customer_name %></td>
                                    <td><%= order.restaurant_name %></td>
                                    <td><%= order.rider_name || 'Not assigned' %></td>
                                    <td>$<%= parseFloat(order.total_amount).toFixed(2) %></td>
                                    <td>
                                        <span class="badge badge-<%= order.order_status %>">
                                            <%= order.order_status %>
                                        </span>
                                    </td>
                                    <td><%= new Date(order.created_at).toLocaleString() %></td>
                                    <td>
                                        <a href="/admin/orders/<%= order.order_id %>" class="btn btn-outline btn-small">View Details</a>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <% } else { %>
            <div class="card">
                <div class="card-body text-center">
                    <p style="color: var(--medium-gray); font-size: 1.1rem;">
                        No orders found for the selected filter.
                    </p>
                </div>
            </div>
            <% } %>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Food Delivery System. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
