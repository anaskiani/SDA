<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Food Delivery</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js" defer></script>
</head>
<body>
    <% if (success) { %>
    <div data-success="<%= success %>" style="display: none;"></div>
    <% } %>
    <% if (error) { %>
    <div data-error="<%= error %>" style="display: none;"></div>
    <% } %>

    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <h1>🍔 FoodDelivery</h1>
            </div>
            <div class="nav-links">
                <span class="user-info">Welcome, <%= user.full_name %>!</span>
                <a href="/customer/restaurants" class="btn btn-primary">Browse Restaurants</a>
                <a href="/customer/cart" class="btn btn-outline">Cart</a>
                <a href="/auth/logout" class="btn btn-outline">Logout</a>
            </div>
        </div>
    </nav>

    <main class="dashboard">
        <div class="container">
            <div class="dashboard-header">
                <h1 class="dashboard-title">Customer Dashboard</h1>
                <p class="dashboard-subtitle">Manage your orders and discover new restaurants</p>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-value"><%= recentOrders.length %></div>
                    <div class="stat-label">Recent Orders</div>
                </div>
                <div class="stat-card secondary">
                    <div class="stat-value">-</div>
                    <div class="stat-label">Active Orders</div>
                </div>
                <div class="stat-card success">
                    <div class="stat-value">-</div>
                    <div class="stat-label">Total Spent</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Quick Actions</h2>
                </div>
                <div class="card-body">
                    <div class="grid grid-3">
                        <a href="/customer/restaurants" class="card" style="text-decoration: none; color: inherit;">
                            <h3 style="color: var(--primary-color); margin-bottom: 0.5rem;">🍕 Browse Restaurants</h3>
                            <p style="color: var(--medium-gray); margin: 0;">Discover new restaurants and cuisines</p>
                        </a>
                        <a href="/customer/orders" class="card" style="text-decoration: none; color: inherit;">
                            <h3 style="color: var(--primary-color); margin-bottom: 0.5rem;">📦 My Orders</h3>
                            <p style="color: var(--medium-gray); margin: 0;">View and track your orders</p>
                        </a>
                        <a href="/customer/cart" class="card" style="text-decoration: none; color: inherit;">
                            <h3 style="color: var(--primary-color); margin-bottom: 0.5rem;">🛒 Shopping Cart</h3>
                            <p style="color: var(--medium-gray); margin: 0;">Review your cart items</p>
                        </a>
                    </div>
                </div>
            </div>

            <% if (recentOrders && recentOrders.length > 0) { %>
            <div class="card">
                <div class="card-header d-flex justify-between align-center">
                    <h2 class="card-title">Recent Orders</h2>
                    <a href="/customer/orders" class="btn btn-outline btn-small">View All</a>
                </div>
                <div class="card-body">
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Restaurant</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentOrders.forEach(order => { %>
                                <tr>
                                    <td>#<%= order.order_id %></td>
                                    <td><%= order.restaurant_name %></td>
                                    <td>$<%= parseFloat(order.total_amount).toFixed(2) %></td>
                                    <td>
                                        <span class="badge badge-<%= order.order_status %>">
                                            <%= order.order_status %>
                                        </span>
                                    </td>
                                    <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <a href="/customer/orders/<%= order.order_id %>" class="btn btn-outline btn-small">View</a>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <% } else { %>
            <div class="card">
                <div class="card-body text-center">
                    <p style="color: var(--medium-gray); font-size: 1.1rem; margin-bottom: 1rem;">
                        You haven't placed any orders yet.
                    </p>
                    <a href="/customer/restaurants" class="btn btn-primary">Browse Restaurants</a>
                </div>
            </div>
            <% } %>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Food Delivery System. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
